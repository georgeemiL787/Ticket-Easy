# Copy to .env and edit. Never commit real keys. Every variable is optional; the values shown are the defaults.
TEAM_B_MODE=standin
TEAM_B_STORE=memory
# TEAM_B_CONFIG_DIR=config/tenants
# TEAM_B_DATA_DIR=data
# TEAM_B_FIXTURES_DIR=fixtures
# TEAM_B_DB_PATH=var/team_b.sqlite3
TEAM_B_LLM=none
OLLAMA_URL=http://127.0.0.1:11434
TEAM_B_OLLAMA_MODEL=qwen3:8b
# OPENROUTER_API_KEY=
# TEAM_B_LLM_MODEL=
TEAM_B_LLM_TIMEOUT_S=20
# TEAM_B_FIXED_TODAY=2026-09-28
TEAM_B_CAPABILITY_TTL_S=60
TEAM_B_LOG_JSON=true
TEAM_B_RETENTION_DAYS=90
TEAM_B_RATE_LIMIT_PER_MIN=20
# Let the AI model reword replies. Every number, date, id and amount is checked; needs TEAM_B_LLM. 0 or 1.
TEAM_B_LLM_REWRITE=0
