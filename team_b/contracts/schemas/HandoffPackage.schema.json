          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "action",
        "decision",
        "reason_code"
      ],
      "title": "PolicyRecord",
      "type": "object"
    }
