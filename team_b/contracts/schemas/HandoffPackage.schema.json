    "CustomerSnapshot": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer Id"
        },
        "orders": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Orders",
          "type": "array"
        },
        "phone_masked": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone Masked"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "title": "CustomerSnapshot",
      "type": "object"
    },
    "EscalationReason": {
      "description": "Why a conversation goes to a human. Each one has a priority and a suggested next step (later prompts).",
      "enum": [
        "customer_request",
        "mandatory_risk",
        "policy_denied",
        "approval_required",
        "repeated_tool_failure",
        "unverified_result",
        "no_evidence",
        "dependency_unavailable",
        "low_confidence",
        "identity_failed",
        "ownership_mismatch",
        "high_frustration",
        "capability_missing",
        "unsupported"
      ],
      "title": "EscalationReason",
      "type": "string"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "role": {
          "enum": [
            "customer",
            "agent",
            "human_agent",
            "system"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        }
      },
      "required": [
        "role",
        "text",
        "at"
      ],
      "title": "Message",
      "type": "object"
    },
    "PolicyQuote": {
      "additionalProperties": false,
      "description": "A policy passage quoted exactly as written, with its source.",
      "properties": {
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "citation",
        "text"
      ],
      "title": "PolicyQuote",
      "type": "object"
    },
    "PolicyRecord": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
