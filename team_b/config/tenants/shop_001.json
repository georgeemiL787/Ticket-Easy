{
  "tenant_id": "shop_001",
  "display_name": "Nile Style",
  "default_locale": "ar",
  "history_max_turns": 12,
  "order_id_pattern": "NS-\\d{4,6}",
  "order_id_prefix": "NS-",
  "identity": {
    "verify_tool": "verify_customer",
    "required_slots": [
      "order_id",
      "phone"
    ],
    "max_attempts": 2
  },
  "escalation": {
    "max_tool_failures": 2,
    "max_clarifications": 2,
    "min_intent_confidence": 0.55,
    "escalate_on_deny": true,
    "escalate_on_high_frustration": true
  },
  "permissions": {
    "allowed_tools": [
      "verify_customer",
      "get_order",
      "list_customer_orders",
      "create_return",
      "create_exchange",
      "create_refund",
      "cancel_order",
      "update_delivery_address",
      "apply_voucher",
      "create_ticket"
    ],
    "max_risk": "high",
    "confirm_operation_kinds": [
      "create",
      "update",
      "delete"
    ]
  },
  "intents": {
    "policy_question": {
      "kind": "knowledge",
      "description": "A question about shop policies (returns, refunds, shipping, payment, FAQ) that needs no order data.",
      "examples": [
        "What is your return policy?",
        "ممكن ارجع المنتج بعد كام يوم من الاستلام؟",
        "emta a2dar araga3 el montag?"
      ],
      "required_slots": [],
      "argument_map": {}
    },
    "greeting": {
      "kind": "smalltalk",
      "description": "A greeting or thanks with no request.",
      "examples": [
        "Hello",
        "السلام عليكم",
        "ahlan, ezayak"
      ],
      "required_slots": [],
      "argument_map": {}
    },
    "order_status": {
      "kind": "lookup",
      "description": "Where is my order, what is its status or delivery date.",
      "examples": [
        "Where is my order NS-20877?",
        "الاوردر بتاعي وصل فين؟",
        "el order NS-20877 et2akhar, 3ayez a3raf feen"
      ],
      "required_slots": [
        "order_id"
      ],
      "lookup_tool": "get_order",
      "knowledge_query": "late delivery shipping",
      "knowledge_when": "order_late",
      "argument_map": {}
    },
    "return_request": {
      "kind": "action",
      "description": "The customer wants to return a delivered item.",
      "examples": [
        "I want to return my order NS-20512",
        "عايز ارجع المنتج لان المقاس مش مظبوط",
        "3ayez araga3 el order 3shan el ma2as msh mazboot"
      ],
      "required_slots": [
        "order_id",
        "reason"
      ],
      "lookup_tool": "get_order",
      "action_tool": "create_return",
      "knowledge_query": "return policy",
      "argument_map": {
        "order_id": "slot:order_id",
        "reason": "slot:reason"
      },
      "labels": {
        "en": "return the item",
        "ar": "ترجيع المنتج",
        "arabizi": "return el montag"
      }
    },
    "exchange_request": {
      "kind": "action",
      "description": "The customer wants another size or color of a delivered item.",
      "examples": [
        "I want to exchange it for a bigger size",
        "عايز ابدل المقاس",
        "3ayza abdel el ma2as"
      ],
      "required_slots": [
        "order_id",
        "reason"
      ],
      "lookup_tool": "get_order",
      "action_tool": "create_exchange",
      "knowledge_query": "exchange policy",
      "argument_map": {
        "order_id": "slot:order_id",
        "reason": "slot:reason"
      },
      "labels": {
        "en": "exchange it",
        "ar": "استبدال المنتج",
        "arabizi": "estebdal el montag"
      }
    },
    "refund_request": {
      "kind": "action",
      "description": "The customer wants their money back.",
      "examples": [
        "I want a refund for order NS-20512",
        "عايز فلوسي ترجع",
        "3ayez flousi el order mesh 3agebny"
      ],
      "required_slots": [
        "order_id"
      ],
      "lookup_tool": "get_order",
      "action_tool": "create_refund",
      "knowledge_query": "refund policy",
      "argument_map": {
        "order_id": "slot:order_id",
        "amount": "fact:order_total"
      },
      "labels": {
        "en": "get a refund",
        "ar": "استرداد الفلوس",
        "arabizi": "estredad el felous"
      }
    },
    "cancel_order": {
      "kind": "action",
      "description": "The customer wants to cancel an order.",
      "examples": [
        "Please cancel my order",
        "الغي الاوردر لو سمحت",
        "3ayez alghy el order"
      ],
      "required_slots": [
        "order_id"
      ],
      "lookup_tool": "get_order",
      "action_tool": "cancel_order",
      "knowledge_query": "cancel order",
      "argument_map": {
        "order_id": "slot:order_id"
      },
      "labels": {
        "en": "cancel the order",
        "ar": "إلغاء الأوردر",
        "arabizi": "elgha2 el order"
      }
    },
    "change_address": {
      "kind": "action",
      "description": "The customer wants to change the delivery address of an order.",
      "examples": [
        "I need to change the delivery address",
        "عايز اغير عنوان التوصيل",
        "3ayez a8ayar el 3enwan"
      ],
      "required_slots": [
        "order_id",
        "new_address"
      ],
      "lookup_tool": "get_order",
      "action_tool": "update_delivery_address",
      "knowledge_query": "change delivery address",
      "argument_map": {
        "order_id": "slot:order_id",
        "new_address": "slot:new_address"
      }
    },
    "voucher_request": {
      "kind": "action",
      "description": "A late order and the customer asks for the compensation voucher.",
      "examples": [
        "My order is late, do I get a voucher?",
        "الاوردر اتاخر وعايز كوبون",
        "el order et2akhar, fi kobon ta3weed?"
      ],
      "required_slots": [
        "order_id"
      ],
      "lookup_tool": "get_order",
      "action_tool": "apply_voucher",
      "knowledge_query": "late delivery voucher",
      "argument_map": {
        "order_id": "slot:order_id",
        "amount": "const:100",
        "reason": "const:late_delivery"
      }
    },
    "complaint": {
      "kind": "action",
      "description": "The customer wants to file a complaint, which opens a support ticket.",
      "examples": [
        "I want to file a complaint about my delivery",
        "عايز اقدم شكوى",
        "3ayez a2adem shakwa 3an el mandoob"
      ],
      "required_slots": [
        "order_id",
        "description"
      ],
      "action_tool": "create_ticket",
      "argument_map": {
        "subject": "const:Customer complaint",
        "description": "slot:description",
        "order_id": "slot:order_id"
      }
    },
    "human_request": {
      "kind": "handoff",
      "description": "The customer asks to talk to a person.",
      "examples": [
        "I want to talk to a human",
        "عايز اكلم حد من خدمة العملاء",
        "3ayez akalem mowazaf"
      ],
      "required_slots": [],
      "argument_map": {}
    }
  },
  "conflicting_intents": [
    [
      "return_request",
      "exchange_request"
    ],
    [
      "exchange_request",
      "refund_request"
    ],
    [
      "return_request",
      "cancel_order"
    ],
    [
      "exchange_request",
      "cancel_order"
    ]
  ]
}
