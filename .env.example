# Ticket-Easy: every setting the service reads. Copy to .env (docker compose reads it) and change what you need.
# Nothing here is required: the defaults run the demo. Variables left out use the default shown.

# ---- how the stack is started (docker compose only) ----
TEAM_B_PORT=8010                  # the port on your computer for the chat, inbox and dashboard

# ---- the service ----
TEAM_B_MODE=standin               # standin: its own fake shop, policies and rules. live: the real services (Phase 6, not available yet)
TEAM_B_STORE=sqlite               # memory (gone on restart) or sqlite (kept in a volume)
TEAM_B_DB_PATH=/data/team_b.sqlite3
# TEAM_B_CONFIG_DIR=              # where the businesses' configuration files are (default: config/tenants)
# TEAM_B_DATA_DIR=                # wording and word lists (default: data)
# TEAM_B_FIXTURES_DIR=            # the demo shop's data (default: fixtures)
TEAM_B_FIXED_TODAY=2026-09-28     # the demo orders are dated against this day. Leave empty for the real date.
TEAM_B_LOG_JSON=true              # true: one JSON line per event. false: readable lines
TEAM_B_RATE_LIMIT_PER_MIN=20      # messages one conversation may send per minute
TEAM_B_RETENTION_DAYS=90          # older conversations, decision logs and finished cases are deleted
TEAM_B_CAPABILITY_TTL_S=60        # how long the list of shop actions is remembered
TEAM_B_QUEUE_MAX_RUNS=3           # requests answered in one reply when a message holds several

# ---- alerts for managers ----
TEAM_B_ALERT_INTERVAL_S=60        # how often the alert rules are checked
# TEAM_B_ALERT_WEBHOOK=https://example.com/hook   # receives every opened and resolved alert as JSON

# ---- the AI model (optional; the service works fully without it) ----
TEAM_B_LLM=none                   # none, ollama or openrouter. `make demo-full` sets ollama for you.
OLLAMA_URL=http://127.0.0.1:11434
TEAM_B_OLLAMA_MODEL=qwen3:8b
# OPENROUTER_API_KEY=             # needed when TEAM_B_LLM=openrouter
# TEAM_B_LLM_MODEL=               # overrides the provider's default model
TEAM_B_LLM_TIMEOUT_S=20
TEAM_B_LLM_REWRITE=0              # 1: the model may reword some replies; every number, date and id is checked

# ---- testing only: never set these in production ----
# TEAM_B_ENABLE_TEST_ADMIN=1      # adds /v1/_test/* so the load test can switch parts off and read the shop's audit log
