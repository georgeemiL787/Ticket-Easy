    {"variants": ["refund", "refunds", "refunded", "refunding", "reimburse", "reimbursed"], "means": ["رد", "المبلغ", "رد المبلغ", "استرداد"]},
    {"variants": ["damaged", "defective", "broken", "faulty", "defect"], "means": ["التالفة", "المعيبة"]},
