# Live Demo settings for the local run. Copy to ops/local/live_demo.env (git-ignored) and edit.
# The tools service reads the LIVE_DEMO_* lines at start (ops/local/serve.py tools / up). Restart the tools service after a change.

# Switch Live Demo execution on: tools built on a Live Demo connector then call the real API.
TOOLS_LIVE_DEMO_ENABLED=true
# The exact host:port of every real API an owner may configure (anything else is refused).
TOOLS_LIVE_DEMO_HOSTS=api.github.com:443
# Hosts allowed to resolve to a private/loopback address. Development networks only; leave empty otherwise.
TOOLS_LIVE_DEMO_PRIVATE_HOSTS=
# Calls per minute per live connector (MCP calls and live tests together).
TOOLS_LIVE_DEMO_CALLS_PER_MINUTE=30

# --- your own API, for ops/local/live_demo_check.py --api custom ---
# The real API's base URL (its host:port must also be in TOOLS_LIVE_DEMO_HOSTS) and its OpenAPI file.
# LIVE_DEMO_BASE_URL=https://api.example.com
# LIVE_DEMO_SPEC=ops/local/live_specs/my_api.openapi.json
# What the tool should do (the owner's request to the tools service), and one read the demo account may run.
# LIVE_DEMO_GOAL=Let a signed-in customer look up one of their own orders by order id; change nothing.
# LIVE_DEMO_TEST_ARGUMENTS={"order_id": "A-1001"}
# The dedicated demo account's credentials: a bearer token, or a username and password for an OAuth2 password login.
# They are stored only in the tools service's local database through its identity form, never printed or committed.
# LIVE_DEMO_TOKEN=
# LIVE_DEMO_USERNAME=
# LIVE_DEMO_PASSWORD=
