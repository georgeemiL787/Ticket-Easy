{
  "properties": {
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[a-z0-9_]{1,64}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "conversation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Id"
    },
    "query": {
      "description": "Redacted description of the open case",
      "maxLength": 2000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "risk_categories": {
      "description": "classify_risk categories of the open case. Required (may be empty); any entry means no precedent is offered, because mandatory-risk cases must reach a human fresh.",
      "items": {
        "enum": [
          "fraud_suspected",
          "legal_regulatory",
          "medical_safety",
          "compensation_demand",
          "identity_concern"
        ],
        "type": "string"
      },
      "title": "Risk Categories",
      "type": "array"
    },
    "top_k": {
      "default": 3,
      "maximum": 10,
      "minimum": 1,
      "title": "Top K",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "tenant_id",
    "query",
    "risk_categories"
  ],
  "title": "SearchResolutionsRequest",
  "type": "object"
}
