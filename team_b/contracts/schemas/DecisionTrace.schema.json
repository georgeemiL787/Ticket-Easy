{
  "$defs": {
    "Decision": {
      "description": "Every customer message ends in exactly one of these.",
      "enum": [
        "answer",
        "clarify",
        "verify_identity",
        "confirm",
        "execute",
        "refuse",
        "handoff"
      ],
      "title": "Decision",
      "type": "string"
    },
    "EscalationReason": {
      "description": "Why a conversation goes to a human. Each one has a priority and a suggested next step (later prompts).",
      "enum": [
        "customer_request",
        "mandatory_risk",
        "policy_denied",
        "approval_required",
        "repeated_tool_failure",
        "unverified_result",
        "no_evidence",
        "dependency_unavailable",
        "low_confidence",
        "identity_failed",
        "ownership_mismatch",
        "high_frustration",
        "capability_missing",
        "unsupported"
      ],
      "title": "EscalationReason",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "citation",
        "document_id",
        "version",
        "score"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "IntentCandidate": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "confidence"
      ],
      "title": "IntentCandidate",
      "type": "object"
    },
    "Language": {
      "description": "Language style of the customer message.",
      "enum": [
        "en",
        "ar",
        "mixed",
        "arabizi"
      ],
      "title": "Language",
      "type": "string"
    },
    "PermissionRecord": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "allowed"
      ],
      "title": "PermissionRecord",
      "type": "object"
    },
    "PolicyRecord": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "citations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "decision": {
          "enum": [
            "allow",
            "deny",
            "require_human"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "action",
        "decision",
        "reason_code"
      ],
      "title": "PolicyRecord",
      "type": "object"
    },
    "ProposalRecord": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "tool",
        "state"
      ],
      "title": "ProposalRecord",
      "type": "object"
    },
    "SessionIdentity": {
      "additionalProperties": false,
      "description": "Has this customer proved who they are? Set only by the identity check, never from what the customer says.",
      "properties": {
        "attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "customer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer Id"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "title": "SessionIdentity",
      "type": "object"
    },
    "ToolCallRecord": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "default": "customer",
          "enum": [
            "customer",
            "human"
          ],
          "title": "Actor",
          "type": "string"
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Id"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "audit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Id"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "operation_kind": {
          "enum": [
            "read",
            "create",
            "update",
            "delete"
          ],
          "title": "Operation Kind",
          "type": "string"
        },
        "policy_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Request Id"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "success",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "tool",
        "operation_kind",
        "status"
      ],
      "title": "ToolCallRecord",
      "type": "object"
    },
    "TraceStep": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "duration_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Duration Ms",
          "type": "number"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "status"
      ],
      "title": "TraceStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_intent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Intent"
    },
    "conversation_id": {
      "minLength": 1,
      "title": "Conversation Id",
      "type": "string"
    },
    "customer_message": {
      "default": "",
      "title": "Customer Message",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "decision_reason": {
      "default": "",
      "title": "Decision Reason",
      "type": "string"
    },
    "entities": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Entities",
      "type": "object"
    },
    "errors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "escalation_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/EscalationReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_empty_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Empty Reason"
    },
    "frustration": {
      "anyOf": [
        {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frustration"
    },
    "handoff_case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Handoff Case Id"
    },
    "identity": {
      "$ref": "#/$defs/SessionIdentity"
    },
    "intents": {
      "default": [],
      "items": {
        "$ref": "#/$defs/IntentCandidate"
      },
      "title": "Intents",
      "type": "array"
    },
    "kind": {
      "default": "customer_turn",
      "enum": [
        "customer_turn",
        "human_action"
      ],
      "title": "Kind",
      "type": "string"
    },
    "knowledge_answer": {
      "default": false,
      "title": "Knowledge Answer",
      "type": "boolean"
    },
    "language": {
      "anyOf": [
        {
          "$ref": "#/$defs/Language"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latency_ms": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Latency Ms",
      "type": "number"
    },
    "nlu_method": {
      "anyOf": [
        {
          "enum": [
            "rules",
            "llm",
            "rules_fallback"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nlu Method"
    },
    "permission": {
      "anyOf": [
        {
          "$ref": "#/$defs/PermissionRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PolicyRecord"
      },
      "title": "Policy",
      "type": "array"
    },
    "proposals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProposalRecord"
      },
      "title": "Proposals",
      "type": "array"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "response_citations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Response Citations",
      "type": "array"
    },
    "response_text": {
      "default": "",
      "title": "Response Text",
      "type": "string"
    },
    "risk_categories": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Risk Categories",
      "type": "array"
    },
    "steps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TraceStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "tool_calls": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolCallRecord"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "turn_index": {
      "minimum": 0,
      "title": "Turn Index",
      "type": "integer"
    },
    "versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    }
  },
  "required": [
    "trace_id",
    "request_id",
    "tenant_id",
    "conversation_id",
    "turn_index",
    "decision"
  ],
  "title": "DecisionTrace",
  "type": "object"
}
