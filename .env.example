# Ticket-Easy: every setting the service reads. Copy to .env (docker compose reads it) and change what you need.
# Nothing here is required: the defaults run the demo. Variables left out use the default shown.

# ---- how the stack is started (docker compose only) ----
TEAM_B_PORT=8010                  # the port on your computer for the chat, inbox and dashboard

# ---- the service ----
TEAM_B_MODE=standin               # standin: its own fake shop, policies and rules. live: the real Team A service (the shop is still a stand-in)
# TEAM_B_TEAM_A_URL=http://127.0.0.1:8001   # TEAM_B_MODE=live: where Team A's service listens
# TEAM_B_TEAM_A_TIMEOUT_S=10
TEAM_B_TEAM_A_KEY=                      # X-Service-Key sent to Team A (needed when Team A runs with SERVICE_API_KEY / SERVICE_API_KEYS)
TEAM_B_TEAM_A_ADMIN_KEY=                # Team A ADMIN_API_KEY: turns on the knowledge and guardrail pages (documents, index, rules)
# TEAM_B_TEAM_C_CONFIG=                    # Team C sandbox tools over MCP (TEST-ONLY, local runs; see Docs/INTEGRATION.md)
TEAM_B_STORE=sqlite               # memory (gone on restart) or sqlite (kept in a volume)
TEAM_B_DB_PATH=/data/team_b.sqlite3
# TEAM_B_CONFIG_DIR=              # where the businesses' configuration files are (default: config/tenants)
# TEAM_B_DATA_DIR=                # wording and word lists (default: data)
# TEAM_B_FIXTURES_DIR=            # the demo shop's data (default: fixtures)
TEAM_B_FIXED_TODAY=2026-09-28     # the demo orders are dated against this day. Leave empty for the real date.
TEAM_B_CLOCK_TICKS=false          # true: with FIXED_TODAY the clock keeps running from that day (new cases get real ages)
TEAM_B_LOG_JSON=true              # true: one JSON line per event. false: readable lines
TEAM_B_RATE_LIMIT_PER_MIN=20      # messages one conversation may send per minute
TEAM_B_RETENTION_DAYS=90          # older conversations, decision logs and finished cases are deleted
# TEAM_B_USAGE_LOG=            # a file path: one JSON line per AI request with the provider's token counts (no text, no keys). Empty = off
# TEAM_B_USAGE_RUN_LABEL=       # free text written into every usage line (which run it belongs to)
TEAM_B_CAPABILITY_TTL_S=60        # how long the list of shop actions is remembered
TEAM_B_QUEUE_MAX_RUNS=3           # requests answered in one reply when a message holds several

# ---- sign-in (inbox, dashboard, decision logs) ----
TEAM_B_AUTH_REQUIRED=1            # 1: staff must sign in. 0 only for a quick local experiment: anyone could read customer data.
# TEAM_B_SECRET_KEY=              # signs the sign-in cookie. Unset: a random key per start (everybody signs in again after a restart).
#                                 # Set it (a long random text) so sign-ins survive a restart: python -c "import secrets; print(secrets.token_urlsafe(48))"
TEAM_B_COOKIE_SECURE=0            # 1 when you serve it over https: the cookie then never travels over plain http
TEAM_B_SESSION_HOURS=12           # how long a sign-in lasts
# TEAM_B_CHAT_API_KEYS=shop_001=change-me   # a business listed here needs the header X-Api-Key on its customer chat

# ---- alerts for managers ----
TEAM_B_ALERT_INTERVAL_S=60        # how often the alert rules are checked
# TEAM_B_ALERT_WEBHOOK=https://example.com/hook   # receives every opened and resolved alert as JSON

# ---- the AI model (optional; the service works fully without it) ----
TEAM_B_LLM=none                   # none, ollama, openrouter or openai (any OpenAI-format server). Left unset, a TEAM_B_LLM_BASE_URL + TEAM_B_LLM_MODEL turns the AI model on.
OLLAMA_URL=http://127.0.0.1:11434
TEAM_B_OLLAMA_MODEL=qwen3:8b
# OPENROUTER_API_KEY=             # needed when TEAM_B_LLM=openrouter
# TEAM_B_LLM_BASE_URL=            # TEAM_B_LLM=openai: any server that speaks the OpenAI chat format, e.g. https://api.groq.com/openai/v1
# TEAM_B_LLM_API_KEY=            # its key; several keys separated by commas are rotated when one is rate-limited (keep them in .env only)
# TEAM_B_LLM_MODEL=               # overrides the provider's default model
TEAM_B_LLM_TIMEOUT_S=20
TEAM_B_LLM_MAX_WAIT_S=4           # a call waits at most this long for its rate-limit slot (see the per-job limits below), then the job falls back to the rules or the template
# The three switches below are ON for the demo and NEED an AI model: with TEAM_B_LLM=none the service refuses to start,
# so set them to 0 when you run without a model. (The built-in default in the code is 0, so the tests and a plain start work.)
TEAM_B_LLM_REWRITE=1              # 1: the model words answers, questions and identity requests like a person, and greetings and small talk naturally; every number, date and id is checked
TEAM_B_LLM_POLICY=1               # 1: an AI policy agent reads the retrieved policy and may send an action to a person or refuse it; it can never loosen the rule checker
TEAM_B_LLM_KNOWLEDGE=1            # 1: the model writes the policy search query and words the policy answer from the passages (quoted verbatim underneath)
TEAM_B_LLM_REVIEW=1               # 1: a reviewer checks every written reply and every write before it goes out; it can only make things stricter (it includes the policy agent of TEAM_B_LLM_POLICY)

# ---- the agent (the AI model plans and picks the next move; code checks every move) ----
TEAM_B_AGENT_MODE=on              # on, off or shadow; a business may set its own agent_mode in config/tenants. It only runs when the ORCHESTRATOR job has an AI model, else the usual step-by-step flow is used. (shadow: not built yet, like off)
TEAM_B_AGENT_MAX_MOVES=5          # how many times the agent may be asked for a move per message; beyond that the usual flow takes over
TEAM_B_AGENT_TURN_TIMEOUT_S=20    # seconds the agent may take for one message; after that the usual flow takes over
TEAM_B_BUNDLES=1                   # 1: a published tenant bundle (versioned configuration, /v1/admin/tenants/<t>/bundles) replaces config/tenants/<t>.json for its business; 0: only the files are used

# ---- one AI model per job (optional) ----
# The AI model does eight jobs: READER (understands the message), ORCHESTRATOR (plans the next move), KNOWLEDGE (policy
# search and answers), REVIEWER (the policy agent), WRITER (words replies and small talk), WRITER_EGYPTIAN (Egyptian
# Arabic and Arabizi replies), SUMMARY (conversation and handoff summaries) and JUDGE (grades replies in the evaluation).
# A job with no setting of its own uses the general TEAM_B_LLM_* ones above. For a job, write its name after the setting:
#   TEAM_B_LLM_MODEL_<JOB>            the model of this job
#   TEAM_B_LLM_BASE_URL_<JOB>         another provider for this job, e.g. Ollama (then also set its MODEL and API_KEY; the general key is never sent there)
#   TEAM_B_LLM_API_KEY_<JOB>          its key (keep it in .env only)
#   TEAM_B_LLM_FALLBACK_MODEL_<JOB>   used when the model is gone ("not found", "decommissioned") or keeps failing
#   TEAM_B_LLM_REASONING_EFFORT_<JOB> low, medium or high; sent as reasoning_effort only when set (GPT-OSS on Groq)
#   TEAM_B_LLM_RPM_<JOB>              requests per minute this model may be sent; jobs on the same model share one budget
#   TEAM_B_LLM_TPM_<JOB>              tokens per minute (the token counts the server returns keep this honest)
#
# Example for the Groq free plan (read on 10 Oct 2026 from https://console.groq.com/docs/rate-limits : 30 requests/min and
# 8,000 tokens/min per model; the numbers below stay under them. Check that page again before relying on them).
# GPT-OSS 120B plans and reviews, the Qwen model does the rest, GPT-OSS 20B is the backup of the Qwen jobs.
# TEAM_B_LLM=openai
# TEAM_B_LLM_BASE_URL=https://api.groq.com/openai/v1
# TEAM_B_LLM_API_KEY=gsk_first_key,gsk_second_key
# TEAM_B_LLM_MODEL=qwen/qwen3.8-27b
# TEAM_B_LLM_MODEL_ORCHESTRATOR=openai/gpt-oss-120b
# TEAM_B_LLM_REASONING_EFFORT_ORCHESTRATOR=low
# TEAM_B_LLM_RPM_ORCHESTRATOR=25
# TEAM_B_LLM_TPM_ORCHESTRATOR=6000
# TEAM_B_LLM_MODEL_REVIEWER=openai/gpt-oss-120b
# TEAM_B_LLM_REASONING_EFFORT_REVIEWER=low
# TEAM_B_LLM_RPM_REVIEWER=25
# TEAM_B_LLM_TPM_REVIEWER=6000
# TEAM_B_LLM_RPM_READER=25
# TEAM_B_LLM_TPM_READER=6000
# TEAM_B_LLM_FALLBACK_MODEL_READER=openai/gpt-oss-20b
# TEAM_B_LLM_FALLBACK_MODEL_KNOWLEDGE=openai/gpt-oss-20b
# TEAM_B_LLM_FALLBACK_MODEL_WRITER=openai/gpt-oss-20b
# TEAM_B_LLM_FALLBACK_MODEL_SUMMARY=openai/gpt-oss-20b
# TEAM_B_LLM_FALLBACK_MODEL_JUDGE=openai/gpt-oss-20b
# A job on Ollama (for example the Egyptian Arabic writer):
# TEAM_B_LLM_BASE_URL_WRITER_EGYPTIAN=http://127.0.0.1:11434/v1
# TEAM_B_LLM_MODEL_WRITER_EGYPTIAN=hf.co/mradermacher/Nile-Chat-4B-GGUF:Q4_K_M
# TEAM_B_LLM_API_KEY_WRITER_EGYPTIAN=            # Ollama needs none; a hosted provider does

# ---- testing only: never set these in production ----
# TEAM_B_ENABLE_TEST_ADMIN=1      # adds /v1/_test/* so the load test can switch parts off and read the shop's audit log
