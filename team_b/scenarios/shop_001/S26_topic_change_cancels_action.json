{
  "id": "S26",
  "title": "A topic change during a pending confirmation cancels the action",
  "status": "active",
  "owner": "A",
  "setup": {
    "today": "2026-09-28"
  },
  "turns": [
    {
      "say": "I want to return order NS-20790, the size is wrong",
      "expect": {
        "decision": "verify_identity",
        "awaiting": "slot:phone"
      }
    },
    {
      "say": "01123456702",
      "expect": {
        "decision": "confirm",
        "awaiting": "confirmation"
      }
    },
    {
      "say": "actually, how much does shipping cost?",
      "expect": {
        "decision": "answer",
        "awaiting": null,
        "citations_include": [
          "shipping_policy@v1#s3"
        ],
        "text_not_contains": "RET-"
      }
    },
    {
      "say": "yes",
      "expect": {
        "decision": "clarify",
        "text_not_contains": "RET-"
      }
    }
  ],
  "final": {
    "executed_tools": [],
    "no_writes": true,
    "audit_count": 0,
    "trace_invariants": true
  }
}
