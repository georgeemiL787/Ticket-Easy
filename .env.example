# Ticket-Easy: every setting the service reads. Copy to .env (docker compose reads it) and change what you need.
# Nothing here is required: the defaults run the demo. Variables left out use the default shown.

# ---- how the stack is started (docker compose only) ----
AGENT_PORT=8010                  # the port on your computer for the chat, inbox and dashboard

# ---- the service ----
AGENT_BACKENDS=simulated               # simulated: its own fake shop, policies and rules. live: the real knowledge service (the shop is still a simulated service)
# AGENT_KNOWLEDGE_URL=http://127.0.0.1:8001   # AGENT_BACKENDS=live: where the knowledge service listens
# AGENT_KNOWLEDGE_TIMEOUT_S=10
AGENT_KNOWLEDGE_KEY=                      # X-Service-Key sent to the knowledge service (needed when the knowledge service runs with KNOWLEDGE_SERVICE_API_KEY / KNOWLEDGE_SERVICE_API_KEYS)
AGENT_KNOWLEDGE_ADMIN_KEY=                # The knowledge service KNOWLEDGE_ADMIN_API_KEY: turns on the knowledge and guardrail pages (documents, index, rules)
# AGENT_TOOLS_CONFIG=                    # The tools service sandbox tools over MCP (TEST-ONLY, local runs; see docs/INTEGRATION.md)
AGENT_STORE=sqlite               # memory (gone on restart) or sqlite (kept in a volume)
AGENT_DB_PATH=/data/agent.sqlite3
# AGENT_CONFIG_DIR=              # where the businesses' configuration files are (default: config/tenants)
# AGENT_DATA_DIR=                # wording and word lists (default: data)
# AGENT_FIXTURES_DIR=            # the demo shop's data (default: fixtures)
AGENT_FIXED_TODAY=2026-09-28     # the demo orders are dated against this day. Leave empty for the real date.
AGENT_CLOCK_TICKS=false          # true: with FIXED_TODAY the clock keeps running from that day (new cases get real ages)
AGENT_LOG_JSON=true              # true: one JSON line per event. false: readable lines
AGENT_RATE_LIMIT_PER_MIN=20      # messages one conversation may send per minute
AGENT_RETENTION_DAYS=90          # older conversations, decision logs and finished cases are deleted
# AGENT_USAGE_LOG=            # a file path: one JSON line per AI request with the provider's token counts (no text, no keys). Empty = off
# AGENT_USAGE_RUN_LABEL=       # free text written into every usage line (which run it belongs to)
AGENT_CAPABILITY_TTL_S=60        # how long the list of shop actions is remembered
AGENT_QUEUE_MAX_RUNS=3           # requests answered in one reply when a message holds several

# ---- sign-in (inbox, dashboard, decision logs) ----
AGENT_AUTH_REQUIRED=1            # 1: staff must sign in. 0 only for a quick local experiment: anyone could read customer data.
# AGENT_SECRET_KEY=              # signs the sign-in cookie. Unset: a random key per start (everybody signs in again after a restart).
#                                 # Set it (a long random text) so sign-ins survive a restart: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_COOKIE_SECURE=0            # 1 when you serve it over https: the cookie then never travels over plain http
AGENT_SESSION_HOURS=12           # how long a sign-in lasts
# AGENT_CHAT_API_KEYS=shop_001=change-me   # a business listed here needs the header X-Api-Key on its customer chat

# ---- alerts for managers ----
AGENT_ALERT_INTERVAL_S=60        # how often the alert rules are checked
# AGENT_ALERT_WEBHOOK=https://example.com/hook   # receives every opened and resolved alert as JSON

# ---- the AI model (optional; the service works fully without it) ----
AGENT_LLM=none                   # none, ollama, openrouter or openai (any OpenAI-format server). Left unset, a AGENT_LLM_BASE_URL + AGENT_LLM_MODEL turns the AI model on.
OLLAMA_URL=http://127.0.0.1:11434
AGENT_OLLAMA_MODEL=qwen3:8b
# OPENROUTER_API_KEY=             # needed when AGENT_LLM=openrouter
# AGENT_LLM_BASE_URL=            # AGENT_LLM=openai: any server that speaks the OpenAI chat format, e.g. https://api.groq.com/openai/v1
# AGENT_LLM_API_KEY=            # its key; several keys separated by commas are rotated when one is rate-limited (keep them in .env only)
# AGENT_LLM_MODEL=               # overrides the provider's default model
AGENT_LLM_TIMEOUT_S=20
AGENT_LLM_MAX_WAIT_S=4           # a call waits at most this long for its rate-limit slot (see the per-job limits below), then the job falls back to the rules or the template
# The three switches below are ON for the demo and NEED an AI model: with AGENT_LLM=none the service refuses to start,
# so set them to 0 when you run without a model. (The built-in default in the code is 0, so the tests and a plain start work.)
AGENT_LLM_REWRITE=1              # 1: the model words answers, questions and identity requests like a person, and greetings and small talk naturally; every number, date and id is checked
AGENT_LLM_POLICY=1               # 1: an AI policy agent reads the retrieved policy and may send an action to a person or refuse it; it can never loosen the rule checker
AGENT_LLM_KNOWLEDGE=1            # 1: the model writes the policy search query and words the policy answer from the passages (quoted verbatim underneath)
AGENT_LLM_REVIEW=1               # 1: a reviewer checks every written reply and every write before it goes out; it can only make things stricter (it includes the policy agent of AGENT_LLM_POLICY)

# ---- the agent (the AI model plans and picks the next move; code checks every move) ----
# The three AGENT_PLANNING_* settings configure the agent's planning loop. They are named PLANNING, not AGENT_AGENT_*, so
# that AGENT_PLANNING_MODE is not confused with the AGENT_ prefix of the service itself.
AGENT_PLANNING_MODE=on              # on, off or shadow; a business may set its own agent_mode in config/tenants. It only runs when the PLANNER job has an AI model, else the usual step-by-step flow is used. (shadow: not built yet, like off)
AGENT_PLANNING_MAX_MOVES=5          # how many times the agent may be asked for a move per message; beyond that the usual flow takes over
AGENT_PLANNING_TURN_TIMEOUT_S=20    # seconds the agent may take for one message; after that the usual flow takes over
AGENT_BUNDLES=1                   # 1: a published tenant bundle (versioned configuration, /v1/admin/tenants/<t>/bundles) replaces config/tenants/<t>.json for its business; 0: only the files are used

# ---- one AI model per job (optional) ----
# The AI model does eight jobs: READER (understands the message), PLANNER (plans the next move), KNOWLEDGE (policy
# search and answers), REVIEWER (the policy agent), WRITER (words replies and small talk), WRITER_EGYPTIAN (Egyptian
# Arabic and Arabizi replies), SUMMARY (conversation and handoff summaries) and JUDGE (grades replies in the evaluation).
# A job with no setting of its own uses the general AGENT_LLM_* ones above. For a job, write its name after the setting:
#   AGENT_LLM_MODEL_<JOB>            the model of this job
#   AGENT_LLM_BASE_URL_<JOB>         another provider for this job, e.g. Ollama (then also set its MODEL and API_KEY; the general key is never sent there)
#   AGENT_LLM_API_KEY_<JOB>          its key (keep it in .env only)
#   AGENT_LLM_FALLBACK_MODEL_<JOB>   used when the model is gone ("not found", "decommissioned") or keeps failing
#   AGENT_LLM_REASONING_EFFORT_<JOB> low, medium or high; sent as reasoning_effort only when set (GPT-OSS on Groq)
#   AGENT_LLM_RPM_<JOB>              requests per minute this model may be sent; jobs on the same model share one budget
#   AGENT_LLM_TPM_<JOB>              tokens per minute (the token counts the server returns keep this honest)
#
# Example for the Groq free plan (read on 10 Oct 2026 from https://console.groq.com/docs/rate-limits : 30 requests/min and
# 8,000 tokens/min per model; the numbers below stay under them. Check that page again before relying on them).
# GPT-OSS 120B plans and reviews, the Qwen model does the rest, GPT-OSS 20B is the backup of the Qwen jobs.
# AGENT_LLM=openai
# AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
# AGENT_LLM_API_KEY=gsk_first_key,gsk_second_key
# AGENT_LLM_MODEL=qwen/qwen3.8-27b
# AGENT_LLM_MODEL_PLANNER=openai/gpt-oss-120b
# AGENT_LLM_REASONING_EFFORT_PLANNER=low
# AGENT_LLM_RPM_PLANNER=25
# AGENT_LLM_TPM_PLANNER=6000
# AGENT_LLM_MODEL_REVIEWER=openai/gpt-oss-120b
# AGENT_LLM_REASONING_EFFORT_REVIEWER=low
# AGENT_LLM_RPM_REVIEWER=25
# AGENT_LLM_TPM_REVIEWER=6000
# AGENT_LLM_RPM_READER=25
# AGENT_LLM_TPM_READER=6000
# AGENT_LLM_FALLBACK_MODEL_READER=openai/gpt-oss-20b
# AGENT_LLM_FALLBACK_MODEL_KNOWLEDGE=openai/gpt-oss-20b
# AGENT_LLM_FALLBACK_MODEL_WRITER=openai/gpt-oss-20b
# AGENT_LLM_FALLBACK_MODEL_SUMMARY=openai/gpt-oss-20b
# AGENT_LLM_FALLBACK_MODEL_JUDGE=openai/gpt-oss-20b
# A job on Ollama (for example the Egyptian Arabic writer):
# AGENT_LLM_BASE_URL_WRITER_EGYPTIAN=http://127.0.0.1:11434/v1
# AGENT_LLM_MODEL_WRITER_EGYPTIAN=hf.co/mradermacher/Nile-Chat-4B-GGUF:Q4_K_M
# AGENT_LLM_API_KEY_WRITER_EGYPTIAN=            # Ollama needs none; a hosted provider does

# ---- testing only: never set these in production ----
# AGENT_ENABLE_TEST_ADMIN=1      # adds /v1/_test/* so the load test can switch parts off and read the shop's audit log
