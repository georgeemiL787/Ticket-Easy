      "knowledge_query": "return policy window eligibility",
      "argument_map": {
        "order_id": "slot:order_id",
        "reason": "slot:reason"
      },
      "labels": {
        "en": "return the item",
        "ar": "ترجيع المنتج",
        "arabizi": "return el montag"
      }
    },
    "complaint": {
      "kind": "action",
      "description": "The customer wants to file a complaint, which opens a support ticket.",
      "examples": [
        "I want to file a complaint about my order ORD-30001",
        "عايز اقدم شكوى على الاوردر",
