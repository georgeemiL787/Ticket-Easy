        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "citation": {
          "title": "Citation",
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "document_id",
        "version",
        "section",
        "language",
        "text",
        "score",
        "citation"
