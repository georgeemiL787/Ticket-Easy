# Copy to .env and fill in. Everything here is free to use.

# Local embeddings (Ollama). Pull the model first: ollama pull bge-m3
OLLAMA_URL=http://127.0.0.1:11434 
EMBED_MODEL=bge-m3

# OpenRouter free models, used only for candidate-rule extraction and risk classification.
# Get a free key at https://openrouter.ai/keys. Only models ending in ":free" are accepted.
OPENROUTER_API_KEY=
# Comma-separated; the next one is tried if a model is rate-limited or unavailable.
OPENROUTER_MODELS=qwen/qwen3.8-27b:free

# Shared secret for the rule-review/admin endpoints, sent as the X-Admin-Key header.
# Leave empty to lock those endpoints entirely (they fail closed with 401).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Retrieval evidence thresholds, picked on the dev split with: python -m team_a eval-retrieval --sweep
MIN_COSINE=0.58
MIN_BM25=2.5

