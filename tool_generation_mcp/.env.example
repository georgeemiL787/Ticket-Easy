# Copy to .env. Ollama-only works without a cloud API key.
LLM_PRIMARY=ollama
LLM_FALLBACK=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=240
OLLAMA_CONTEXT=32768
OLLAMA_THINK=false
# Groq, then OpenRouter, then local Ollama:
# LLM_PRIMARY=groq
# LLM_FALLBACK=openrouter,ollama
GROQ_API_KEY=
# Optional backup keys, tried in order before the next provider on rate limits, timeout, connection failure or 5xx.
# Every new call starts with GROQ_API_KEY again; no key is permanently disabled.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=120
GROQ_REASONING_EFFORT=low
# Input tokens this provider accepts in one request. Operation indexes and generated inputs are dense
# API content (about 1.8 characters per token), so batches are sized against this ceiling instead of
# being sent and rejected with HTTP 413. Lower it if your key has a smaller per-request allowance.
GROQ_INPUT_TOKENS=8000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=120
OPENROUTER_INPUT_TOKENS=24000
DATABASE_PATH=data/team_c.sqlite3
ALLOWED_PROJECT_DIRECTORY=D:\projects
# loopback:* allows localhost, 127.x.x.x and ::1 on any port.
# Add explicit remote host:port entries as needed; empty disables fetch.
OPENAPI_FETCH_HOSTS=loopback:*
CODE_MAX_FILES=200
CODE_MAX_ENTRIES=3000
CODE_MAX_FILE_BYTES=131072
CODE_MAX_TOTAL_BYTES=2097152
CODE_MAX_SNIPPETS=12
CODE_MAX_CONTEXT_CHARS=8000
CODE_EXPLORATION_STEPS=2
# Sandbox execution: connector/identity JSON file (keep out of version control) and destination allowlist
CONNECTORS_FILE=
SANDBOX_HOSTS=
# Live Demo: tools that call an owner-configured REAL API with real credentials (README "Live Demo").
# Off by default. LIVE_DEMO_HOSTS lists the exact host:port the owner may configure, e.g. api.example.com:443.
# LIVE_DEMO_PRIVATE_HOSTS lets a listed host resolve to a private/loopback address (development networks only).
LIVE_DEMO_ENABLED=false
LIVE_DEMO_HOSTS=
LIVE_DEMO_PRIVATE_HOSTS=
LIVE_DEMO_CALLS_PER_MINUTE=30
# PRODUCTION: promoted tools act on real customers' data with the business's ONE service credential, scoped to the verified customer
# by Team C (README "Production"). Off by default. PRODUCTION_HOSTS lists the exact host:port of every production API; each must resolve
# to public addresses. PRODUCTION_PRIVATE_HOSTS is a DEVELOPMENT-ONLY exception for a local production-like deployment: keep it EMPTY
# in a real setup. A production connector names its credential as env:VARIABLE or file:/path; the credential itself is never stored.
PRODUCTION_ENABLED=false
PRODUCTION_HOSTS=
PRODUCTION_PRIVATE_HOSTS=
PRODUCTION_CALLS_PER_MINUTE=60
PRODUCTION_CALLS_PER_CUSTOMER_PER_MINUTE=20
# Auto-disable a tool after this many API/integration failures within the window (a customer refused by a check never counts).
PRODUCTION_AUTO_DISABLE_FAILURES=5
PRODUCTION_AUTO_DISABLE_WINDOW_SECONDS=300
# The promotion smoke check runs the tool's read steps as an INTERNAL test customer: JSON objects.
PRODUCTION_SMOKE_CONTEXT=
PRODUCTION_SMOKE_ARGUMENTS=
# Append-only daily audit of production executions (ids and hashes, never values).
PRODUCTION_AUDIT_DIR=data/audit
# The operator's token for production actions on /api/v1 (promote, roll back, save a production connector). Team B holds it; unset = those actions are off.
TEAM_C_ADMIN_TOKEN=
DEV_REVIEWER_ID=local-owner
# Auto-confirm requirements, auto-review enforcement, auto-generate enforcement on build.
# Reduces manual steps in the approval workflow. Set to false for production-like behavior.
DEV_FAST_TRACK=false
# Generate a fresh secret for your local session; see README.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional token usage log: one JSON line per model request (token counts only, never text or keys). Empty = off.
# TEAM_C_USAGE_LOG=
# TEAM_C_USAGE_RUN_LABEL=
