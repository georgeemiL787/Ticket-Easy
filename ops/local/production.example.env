# PRODUCTION settings for the LOCAL run. Copy to ops/local/production.env (git-ignored) to switch them on.
# ops/local/serve.py then also starts "nile-prod": a SEPARATE Nile shop deployment on this machine (port 8104, synthetic data)
# whose one SERVICE token may act for any customer, which is how a real API treats a back-office credential. It is NOT a real
# production API: it exists to show that Team C, not the API, keeps customers apart. A real production setup needs a real API,
# its own service credential and an EMPTY TOOLS_PRODUCTION_PRIVATE_HOSTS.

TOOLS_PRODUCTION_ENABLED=true
# exact host:port of every production API (anything else is refused)
TOOLS_PRODUCTION_HOSTS=127.0.0.1:8104
# DEVELOPMENT ONLY: hosts allowed to resolve to a private/loopback address. Must be empty in a real production setup.
TOOLS_PRODUCTION_PRIVATE_HOSTS=127.0.0.1:8104
TOOLS_PRODUCTION_CALLS_PER_MINUTE=60
TOOLS_PRODUCTION_CALLS_PER_CUSTOMER_PER_MINUTE=20
# The promotion's smoke check runs the tool's read steps as this INTERNAL test customer on this customer's own record.
TOOLS_PRODUCTION_SMOKE_CONTEXT={"customer_id": "C-100"}
TOOLS_PRODUCTION_SMOKE_ARGUMENTS={"order_id": "NS-20877"}
