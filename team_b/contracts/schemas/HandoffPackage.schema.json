          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "tool",
        "state"
