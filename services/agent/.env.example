# Copy to .env and edit. Never commit real keys. Every variable is optional; the values shown are the defaults.
AGENT_BACKENDS=simulated
# AGENT_KNOWLEDGE_URL=http://127.0.0.1:8001
# AGENT_KNOWLEDGE_TIMEOUT_S=10
# AGENT_TOOLS_CONFIG=var/tools.json   # Team C sandbox tools over MCP (TEST-ONLY); see config/tools.example.json
AGENT_STORE=memory
# AGENT_CONFIG_DIR=config/tenants
# AGENT_DATA_DIR=data
# AGENT_FIXTURES_DIR=fixtures
# AGENT_DB_PATH=var/agent.sqlite3
AGENT_LLM=none
OLLAMA_URL=http://127.0.0.1:11434
AGENT_OLLAMA_MODEL=qwen3:8b
# OPENROUTER_API_KEY=
# AGENT_LLM_BASE_URL=
# AGENT_LLM_API_KEY=
# AGENT_LLM_MODEL=
AGENT_LLM_TIMEOUT_S=20
# AGENT_FIXED_TODAY=2026-09-28
AGENT_CAPABILITY_TTL_S=60
AGENT_QUEUE_MAX_RUNS=3
# AGENT_ALERT_WEBHOOK=https://example.com/hook
AGENT_ALERT_INTERVAL_S=60
AGENT_AUTH_REQUIRED=1
# AGENT_SECRET_KEY=
AGENT_COOKIE_SECURE=0
AGENT_SESSION_HOURS=12
# AGENT_CHAT_API_KEYS=shop_001=change-me
# Test only: lets the load test switch simulated services off and read the shop audit log. Never set in production.
# AGENT_ENABLE_TEST_ADMIN=1
AGENT_LOG_JSON=true
AGENT_RETENTION_DAYS=90
AGENT_RATE_LIMIT_PER_MIN=20
# Let the AI model reword replies. Every number, date, id and amount is checked; needs AGENT_LLM. 0 or 1.
AGENT_LLM_REWRITE=0
